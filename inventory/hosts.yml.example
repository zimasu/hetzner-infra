all:
  children:
    k3s_old:
      hosts:
        your-server:
          ansible_host: YOUR_SERVER_IP
          ansible_user: ansible
          ansible_ssh_private_key_file: ~/.ssh/YOUR_KEY
    k3s_new:
      hosts:
        your-server-arm64:
          ansible_host: YOUR_SERVER_IP
          ansible_user: ansible
          ansible_ssh_private_key_file: ~/.ssh/YOUR_KEY
